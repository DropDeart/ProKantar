{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=identity_db;Username=baseforge;Password="
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:8080",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://+:8081",
        "Protocols": "Http2"
      }
    }
  },
  "Auth": {
    "Issuer": "http://localhost:5090/",
    "SigningCertificatePath": "",
    "SigningCertificatePassword": "",
    "AccessTokenLifetimeMinutes": 60,
    "Scopes": [
      {
        "Name": "api",
        "Resource": "baseforge-api"
      }
    ],
    "Clients": [
      {
        "ClientId": "prokantar-app",
        "Secret": null,
        "Public": true,
        "Grants": [
          "password",
          "otp",
          "refresh_token"
        ],
        "Scopes": [
          "api"
        ],
        "RedirectUris": []
      },
      {
        "ClientId": "tracking-service",
        "Secret": "",
        "Public": false,
        "Grants": [
          "client_credentials"
        ],
        "Scopes": [
          "api"
        ],
        "RedirectUris": []
      }
    ],
    "Roles": [
      "Admin",
      "User",
      "SuperAdmin",
      "TenantAdmin",
      "Operator",
      "Driver"
    ],
    "Registration": {
      "Enabled": true,
      "DefaultRole": "User",
      "SelfAssignableRoles": [
        "Driver"
      ]
    },
    "Otp": {
      "Enabled": true,
      "CodeLength": 6,
      "LifetimeSeconds": 180,
      "MaxAttempts": 5,
      "ResendCooldownSeconds": 60,
      "MaxPerHour": 5,
      "MaxVerifyPerTarget": 10,
      "MaxVerifyPerIp": 30,
      "VerifyWindowSeconds": 900,
      "DefaultCountryCode": "+90"
    },
    "MultiTenancy": {
      "Enabled": true,
      "AdminRole": "TenantAdmin",
      "MemberRoles": [
        "Operator"
      ],
      "RequireApproval": true,
      "ApproverRoles": [
        "SuperAdmin"
      ],
      "PortalUrl": "http://localhost:3000"
    },
    "PasswordReset": {
      "Enabled": true,
      "ResetUrl": "http://localhost:3000/sifre-sifirla",
      "TokenLifetimeHours": 2,
      "CooldownSeconds": 60
    },
    "Messaging": {
      "EmailProvider": "Log",
      "SmsProvider": "Log",
      "Smtp": {
        "Host": "",
        "Port": 587,
        "Username": null,
        "Password": "",
        "FromAddress": "",
        "FromName": "ProKantar"
      }
    },
    "SeedAdmin": null,
    "Providers": {
      "Google": {
        "ClientId": "",
        "ClientSecret": ""
      },
      "GitHub": {
        "ClientId": "",
        "ClientSecret": ""
      },
      "Microsoft": {
        "ClientId": "",
        "ClientSecret": ""
      },
      "Facebook": {
        "ClientId": "",
        "ClientSecret": ""
      },
      "Apple": {
        "ClientId": "",
        "TeamId": "",
        "KeyId": "",
        "PrivateKey": ""
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
