# deploy/.env.server — sunucuda doldurulur, git'e GİRMEZ. Şifreler: openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
# Değiştirilmemesi gerekenler: POSTGRES_PASSWORD (volume ilk açılışta oluşur), CERT_PASSWORD (sertifikalarla birlikte).

ASPNETCORE_ENVIRONMENT=Staging

# Alan adları (nginx/prokantar.conf ile aynı)
WEB_HOST=prokantar.com.tr
IDENTITY_HOST=identity.prokantar.com.tr
KANTAR_HOST=kantar.prokantar.com.tr
PLATFORM_HOST=platform.prokantar.com.tr
TRACKING_HOST=tracking.prokantar.com.tr
LOG_HOST=log.prokantar.com.tr

POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=
CERT_PASSWORD=
TRACKING_CLIENT_SECRET=
KANTAR_CLIENT_SECRET=
# Grafana admin şifresi (kullanıcı: admin)
GRAFANA_PASSWORD=

# Kapalı test: SMS/e-posta log'a yazılır (docker logs prokantar-identity-1). Gerçek sağlayıcılar hazır olunca false.
ALLOW_LOG_MESSAGING=true
SMS_PROVIDER=Log
EMAIL_PROVIDER=Log
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_HEADER=

# Şoför TCKN'si NVİ ile doğrulansın mı (sunucudan erişim denenmeli)
NVI_ENABLED=false
# Kendi OSRM sunucusu (boşsa demo sunucu; yalnız test)
OSRM_URL=
# Web arayüzünde /panel/simulasyon (şoför uygulaması + kantar cihazı yerine): kapalı testte 1
UI_SIMULATOR=1
