{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5435;Database=prokantar_tracking_db;Username=baseforge;Password="
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Auth": {
    "ServiceClient": {
      "ClientId": "tracking-service",
      "ClientSecret": ""
    }
  },
  "Tracking": {
    "RetentionMonths": 6,
    "MaxBatchSize": 100,
    "MaxAccuracyM": 100,
    "DepartureFactor": 1.25
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:8080",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://+:8081",
        "Protocols": "Http2"
      }
    }
  },
  "Grpc": {
    "Platform": "http://host.docker.internal:8086"
  },
  "RabbitMq": {
    "Host": "host.docker.internal",
    "Port": 5672,
    "Username": "baseforge",
    "Password": ""
  },
  "Serilog": {
    "LokiUrl": "http://host.docker.internal:3100"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
