# Format referansı — gerçek değerler '.env'de (üretici oluşturur, gitignore'lu). Bu dosya commit edilebilir.
# docker-compose bu dosyadaki değişkenleri ${...} ile okur; yerel 'dotnet run' DotNetEnv ile yükler.

# Bu servisin PostgreSQL şifresi (container ilk oluşturulurken kullanılır; sonradan değiştirmek volume'u sıfırlamayı gerektirir).
POSTGRES_PASSWORD=
# Yerel 'dotnet run' bağlantısı (container içinde docker-compose kendi bağlantı dizesini verir).
ConnectionStrings__Default=Host=localhost;Port=5434;Database=prokantar_platform_db;Username=baseforge;Password=

# Identity'deki 'platform-service' client_credentials istemcisinin secret'ı (auth.yaml clients).
# Boşsa arka plan işlerinden yapılan gRPC çağrıları token taşımaz (kullanıcı istekleri etkilenmez).
Auth__ServiceClient__ClientSecret=

# Netgsm toplu SMS (şoför daveti vb.). Şifre boşsa SMS'ler log'a yazılır.
# Netgsm__Usercode=850xxxxxxx
# Netgsm__MsgHeader=BASLIK
# Netgsm__AppLink=https://prokantar.com
Netgsm__Password=
